# Streamable HTTP transport, for one shared instance serving several clients.
#
# Prefer stdio unless you actually need a shared endpoint. HTTP adds a listening
# socket, a token to rotate, and no per-user identity.

WHMCS_MCP_WHMCS_URL=https://billing.example.com
WHMCS_MCP_API_IDENTIFIER=replace-me
WHMCS_MCP_API_SECRET=replace-me

WHMCS_MCP_PROFILE=readonly

WHMCS_MCP_TRANSPORT=http
WHMCS_MCP_ADDR=0.0.0.0:8080

# Required for a non-loopback bind: the server refuses to start without it.
# An unauthenticated HTTP transport in front of a billing system is a remote
# control plane for it.
#
# Generate with: openssl rand -base64 48
#
# This is a coarse gate answering "may you talk to this server", not an identity
# layer. The audit stream cannot attribute a call to a person through it.
WHMCS_MCP_AUTH_TOKEN=replace-me

WHMCS_MCP_LOG_LEVEL=info
