# Billing profile: invoices, quotes, transactions and orders.
#
# Cannot terminate or modify services. A billing agent that can take a
# customer's server away is not a billing agent.
#
# Advertises 16 tools with ALLOW_DESTRUCTIVE=false, 18 with it enabled.

WHMCS_MCP_WHMCS_URL=https://billing.example.com

# Scope this credential in WHMCS to billing and order actions only.
WHMCS_MCP_API_IDENTIFIER=replace-me
WHMCS_MCP_API_SECRET=replace-me

WHMCS_MCP_PROFILE=billing

# Required for whmcs_invoice_payment_add and whmcs_order_accept. Both move money
# and both still require a confirmation token bound to their exact arguments.
WHMCS_MCP_ALLOW_DESTRUCTIVE=true

# Shorter than the default. A confirmation for a payment should not survive a
# coffee break: if the exchange that justified it has gone cold, get a fresh
# preview.
WHMCS_MCP_CONFIRM_TTL=3m

WHMCS_MCP_LOG_LEVEL=info
