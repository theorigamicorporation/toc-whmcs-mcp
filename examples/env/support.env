# Support profile: ticket triage and client-record maintenance.
#
# Can read everything, and change tickets, client records and users. Cannot
# touch billing or provisioning: those paths do not exist in this process.
#
# Advertises 19 tools with ALLOW_DESTRUCTIVE=false, 20 with it enabled.

WHMCS_MCP_WHMCS_URL=https://billing.example.com

# Scope this credential in WHMCS to ticket and client actions. It should not be
# able to touch invoices even if this server had a bug.
WHMCS_MCP_API_IDENTIFIER=replace-me
WHMCS_MCP_API_SECRET=replace-me

WHMCS_MCP_PROFILE=support

# Leave false unless the agent must actually send replies to customers.
#
# Internal notes (whmcs_ticket_note_add) and status changes
# (whmcs_ticket_update) are plain writes and work without this. Only
# whmcs_ticket_reply needs it, because a sent email cannot be unsent, and it
# still requires a confirmation token per call.
WHMCS_MCP_ALLOW_DESTRUCTIVE=false

# Tickets are long. A smaller page keeps a triage loop from filling the agent's
# context with one busy queue.
WHMCS_MCP_DEFAULT_PAGE_SIZE=15
WHMCS_MCP_MAX_PAGE_SIZE=50

WHMCS_MCP_LOG_LEVEL=info
