# Read-only profile. The safest useful configuration, and the default.
#
# Advertises 15 tools, none of which can change anything. Suitable for an agent
# that answers questions, investigates, or drafts summaries for a human.
#
# Load with:  set -a; source readonly.env; set +a

WHMCS_MCP_WHMCS_URL=https://billing.example.com

# Scope this credential in WHMCS to the Get* actions you actually use.
# System Settings -> API Credentials.
WHMCS_MCP_API_IDENTIFIER=replace-me
WHMCS_MCP_API_SECRET=replace-me

WHMCS_MCP_PROFILE=readonly

# Redundant here (readonly permits no mutation at all), but explicit is better
# than relying on a default staying the same.
WHMCS_MCP_ALLOW_DESTRUCTIVE=false

# Bounds. The defaults are sensible; these are shown so they can be tuned
# deliberately rather than discovered during an incident.
WHMCS_MCP_REQUEST_TIMEOUT=30s
WHMCS_MCP_DEFAULT_PAGE_SIZE=25
WHMCS_MCP_MAX_PAGE_SIZE=200
WHMCS_MCP_MAX_RESPONSE_BYTES=8388608

WHMCS_MCP_LOG_LEVEL=info
