# Admin profile: everything, including provisioning.
#
# Use this only where an agent genuinely needs to suspend, unsuspend or
# terminate services. For anything narrower, use a narrower profile: the
# separation is worth more than the convenience.
#
# Advertises 20 tools with ALLOW_DESTRUCTIVE=false, 25 with it enabled.

WHMCS_MCP_WHMCS_URL=https://billing.example.com

WHMCS_MCP_API_IDENTIFIER=replace-me
WHMCS_MCP_API_SECRET=replace-me

WHMCS_MCP_PROFILE=admin

# Even here this is off by default. Being an administrator is a statement about
# authority, not about intent to delete something right now.
WHMCS_MCP_ALLOW_DESTRUCTIVE=true

# The allowlist only ever subtracts. Use it to give an admin-profile agent a
# narrow job: this one can look after services but cannot touch billing or
# tickets, even though the profile would permit it.
WHMCS_MCP_TOOL_ALLOWLIST=whmcs_status,whmcs_client_get,whmcs_client_services,whmcs_service_suspend,whmcs_service_unsuspend,whmcs_service_terminate

# Short TTL: a termination should be confirmed while the reason is still on
# screen.
WHMCS_MCP_CONFIRM_TTL=2m

WHMCS_MCP_LOG_LEVEL=info
