# toc-whmcs-mcp configuration.
# Copy to .env (`just setup-env`), fill in, and load with:
#   set -a; source .env; set +a
#
# .env is gitignored. Never commit a real credential.

# --- required ---------------------------------------------------------------

# WHMCS root URL. Must be https unless it is loopback: the API credential
# travels in the body of every request.
WHMCS_MCP_WHMCS_URL=https://billing.example.com

# API credential pair, created in WHMCS under System Settings > API Credentials.
# Scope the role in WHMCS to the minimum the profile below needs. The server
# narrows what a credential can do; it never widens it.
WHMCS_MCP_API_IDENTIFIER=
WHMCS_MCP_API_SECRET=

# Only if the WHMCS instance restricts API access by access key.
#WHMCS_MCP_API_ACCESS_KEY=

# --- access control ---------------------------------------------------------

# readonly (default) | support | billing | admin
# Leaving this unset means readonly.
WHMCS_MCP_PROFILE=readonly

# Enable actions classified destructive. Off by default in every profile,
# including admin. Enabled actions still require a confirmation token per call.
WHMCS_MCP_ALLOW_DESTRUCTIVE=false

# Optional comma-separated tool allowlist. It narrows the profile and can never
# widen it. Entries the profile does not grant are logged and ignored.
#WHMCS_MCP_TOOL_ALLOWLIST=whmcs_client_get,whmcs_invoice_list,whmcs_ticket_list

# --- transport --------------------------------------------------------------

# stdio (default) | http
WHMCS_MCP_TRANSPORT=stdio

# http only. A non-loopback address requires WHMCS_MCP_AUTH_TOKEN, or the
# server refuses to start.
#WHMCS_MCP_ADDR=127.0.0.1:8080
#WHMCS_MCP_AUTH_TOKEN=

# --- limits -----------------------------------------------------------------

#WHMCS_MCP_REQUEST_TIMEOUT=30s
#WHMCS_MCP_MAX_RESPONSE_BYTES=8388608
#WHMCS_MCP_MAX_RETRIES=2
#WHMCS_MCP_DEFAULT_PAGE_SIZE=25
#WHMCS_MCP_MAX_PAGE_SIZE=200
#WHMCS_MCP_CONFIRM_TTL=5m

# debug | info | warn | error
#WHMCS_MCP_LOG_LEVEL=info
